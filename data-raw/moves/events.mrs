<runspec version="MOVES6.0.0">
  <description><![CDATA[VEIN portable start and evaporative factor reference. MOVES6.0.0, Washtenaw County MI defaults, calendar 2025, all 13 onroad vehicle types and valid fuels, January weekday. Start exhaust CO/NOx and evaporative THC (permeation, vapor venting, leaks). Temperatures are artificial lookup grid points: hour 1=20 C, 2=10 C, 3=30 C, RH=50%. U.S. reference, not an Ecuador calibration.]]></description>
  <models><model value="ONROAD"/></models>
  <modelscale value="Rates"/>
  <modeldomain value="DEFAULT"/>
  <geographicselections>
    <geographicselection type="COUNTY" key="26161" description="MICHIGAN - Washtenaw County"/>
  </geographicselections>
  <timespan>
    <year key="2025"/><month id="1"/><day id="2"/>
    <beginhour id="1"/><endhour id="3"/><aggregateBy key="Hour"/>
  </timespan>
